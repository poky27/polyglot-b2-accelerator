# --- Discord ---
# Discord Developer Portal -> your app -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional: restrict slash-command registration to one server for instant updates while testing.
# Leave empty to register globally (takes up to ~1h to propagate).
DISCORD_GUILD_ID=

# --- LLM provider (any OpenAI-compatible /chat/completions endpoint) ---
# Pick ONE free provider. Defaults below use Groq (fast, generous free tier, no card required).
# Alternatives: OpenRouter (openrouter.ai/api/v1, has free NousResearch Hermes models),
#               Google Gemini (generativelanguage.googleapis.com/v1beta/openai),
#               Mistral (api.mistral.ai/v1), SambaNova (api.sambanova.ai/v1).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Speech-to-text (voice practice: bot listens to you) ---
# Uses Groq's free Whisper endpoint specifically (most free chat providers don't
# offer audio transcription). If LLM_BASE_URL above is already Groq, you can
# leave STT_API_KEY empty and it'll reuse LLM_API_KEY.
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# --- Text-to-speech (voice practice: bot talks back) ---
# Free, no API key — uses the Microsoft Edge "Read Aloud" service.
# If it ever 403s for you (Microsoft occasionally blocks datacenter/cloud IPs),
# it should still work fine from a normal home connection.
TTS_VOICE_ENGLISH=en-US-AriaNeural
TTS_VOICE_GERMAN=de-DE-KatjaNeural

# --- Bot behavior ---
# Base language the tutor uses for explanations (learner's native language).
NATIVE_LANGUAGE=Spanish
