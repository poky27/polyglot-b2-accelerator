# --- Discord ---
# Discord Developer Portal -> your app -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional: restrict slash-command registration to one server for instant updates while testing.
# Leave empty to register globally (takes up to ~1h to propagate).
DISCORD_GUILD_ID=

# --- LLM provider (any OpenAI-compatible /chat/completions endpoint) ---
# Pick ONE free provider. Defaults below use Groq (fast, generous free tier, no card required).
# Alternatives: OpenRouter (openrouter.ai/api/v1, has free NousResearch Hermes models),
#               Google Gemini (generativelanguage.googleapis.com/v1beta/openai),
#               Mistral (api.mistral.ai/v1), SambaNova (api.sambanova.ai/v1).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Bot behavior ---
# Base language the tutor uses for explanations (learner's native language).
NATIVE_LANGUAGE=Spanish
